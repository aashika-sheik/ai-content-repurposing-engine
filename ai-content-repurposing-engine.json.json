      "name": "When clicking ‘Execute workflow’"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "You are an AI content repurposing assistant.\n\nYour task is to take the topic or rough draft provided below and create social media content for two platforms.\n\nCreate:\n\n1. LinkedIn Post\n- Professional and informative\n- 150–250 words\n- Start with an engaging hook\n- Explain the key idea clearly\n- Use short paragraphs\n- End with a question or call to action\n- Include 3–5 relevant hashtags\n\n2. X Post\n- Concise and engaging\n- Maximum 280 characters\n- Capture the main idea\n- Use 1–3 relevant hashtags\n\nReturn the response EXACTLY in this format:\n\nLINKEDIN:\n[LinkedIn post]\n\nX:\n[X post]\n\nTopic:\nAI automation using n8n to connect different applications and automate repetitive business tasks.",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        160,
        0
      ],
      "id": "739d4089-87b8-439b-8810-e91b2e9f592d",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        32,
        208
      ]
  
    },
    {
      "parameters": {
        "jsCode": "const output = $input.first().json.output;\n\n// Split the AI response into LinkedIn and X sections\nconst linkedinPart = output.split(\"X:\")[0];\nconst xPart = output.split(\"X:\")[1];\n\n// Remove the \"LINKEDIN:\" label\nconst linkedin = linkedinPart.replace(\"LINKEDIN:\", \"\").trim();\nconst x = xPart.trim();\n\n// Return two separate items\nreturn [\n  {\n    json: {\n      platform: \"LinkedIn\",\n      content: linkedin\n    }\n  },\n  {\n    json: {\n      platform: \"X\",\n      content: x\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        16
      ],
      "id": "7243d4f0-4cbb-4e9a-afe2-ac40b500ff1c",
      "name": "Code in JavaScript"
    },
